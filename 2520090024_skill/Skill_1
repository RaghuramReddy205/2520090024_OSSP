#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
    pid_t pid;

    printf("=== [PARENT] Initial Process Started ===\n");
    printf("Parent PID: %d | Shell PID (PPID): %d\n\n", getpid(), getppid());

    // Create child process
    pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(EXIT_FAILURE);
    } 
    else if (pid == 0) {
        // --- CHILD PROCESS ---
        printf("[CHILD] Fork succeeded!\n");
        printf("[CHILD] Child PID: %d | Parent PID (PPID): %d\n", getpid(), getppid());
        printf("[CHILD] Executing 'ls -l' via execvp()...\n\n");

        char *args[] = {"ls", "-l", NULL};

        // Replaces current child image with /bin/ls
        execvp(args[0], args);

        // Code only reaches here if execvp fails
        perror("execvp failed");
        exit(EXIT_FAILURE);
    } 
    else {
        // --- PARENT PROCESS ---
        printf("[PARENT] Waiting for child (PID: %d) to finish...\n", pid);

        int status;
        wait(&status); // Wait for child completion

        if (WIFEXITED(status)) {
            printf("\n[PARENT] Child exited with status code: %d\n", WEXITSTATUS(status));
        }
        printf("=== Process Execution Finished ===\n");
    }

    return 0;
}
