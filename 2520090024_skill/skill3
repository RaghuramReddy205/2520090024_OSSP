#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <termios.h>
#include <ctype.h>

#define INITIAL_CAPACITY 16

// Node structure for the linked list
typedef struct Node {
    char *command;
    struct Node *next;
} Node;

// Global variables
Node *head = NULL;
Node *tail = NULL;

char **history = NULL;
int history_count = 0;
int history_capacity = 0;

// Terminal settings
struct termios original_terminal;

// Restore terminal settings
void restore_terminal() {
    tcsetattr(STDIN_FILENO, TCSANOW, &original_terminal);
}

// Enable raw terminal mode
void enable_raw_mode() {
    tcgetattr(STDIN_FILENO, &original_terminal);

    struct termios raw = original_terminal;

    raw.c_lflag &= ~(ICANON | ECHO);
    raw.c_iflag &= ~(IXON | ICRNL);

    tcsetattr(STDIN_FILENO, TCSANOW, &raw);

    atexit(restore_terminal);
}

// Dynamically allocate the history array
void initialize_history() {
    history_capacity = INITIAL_CAPACITY;

    history = malloc(history_capacity * sizeof(char *));

    if (history == NULL) {
        perror("Memory allocation failed");
        exit(EXIT_FAILURE);
    }
}

// Resize the history array when full
void resize_history() {
    history_capacity *= 2;

    char **temp = realloc(
        history,
        history_capacity * sizeof(char *)
    );

    if (temp == NULL) {
        perror("Memory reallocation failed");
        exit(EXIT_FAILURE);
    }

    history = temp;
}

// Add a command to the linked list
void add_to_linked_list(const char *command) {
    Node *new_node = malloc(sizeof(Node));

    if (new_node == NULL) {
        perror("Node allocation failed");
        exit(EXIT_FAILURE);
    }

    new_node->command = malloc(strlen(command) + 1);

    if (new_node->command == NULL) {
        free(new_node);
        perror("Command allocation failed");
        exit(EXIT_FAILURE);
    }

    strcpy(new_node->command, command);
    new_node->next = NULL;

    if (head == NULL) {
        head = new_node;
        tail = new_node;
    } else {
        tail->next = new_node;
        tail = new_node;
    }
}

// Store a command in history
void add_to_history(const char *command) {
    if (history_count == history_capacity) {
        resize_history();
    }

    history[history_count] = malloc(strlen(command) + 1);

    if (history[history_count] == NULL) {
        perror("Command allocation failed");
        exit(EXIT_FAILURE);
    }

    strcpy(history[history_count], command);

    history_count++;

    add_to_linked_list(command);
}

// Display stored commands
void display_history() {
    printf("\n\n\033[1;36m----- COMMAND HISTORY -----\033[0m\n");

    for (int i = 0; i < history_count; i++) {
        printf("%d. %s\n", i + 1, history[i]);
    }

    if (history_count == 0) {
        printf("No commands stored.\n");
    }
}

// Display the linked list
void display_linked_list() {
    printf("\n\033[1;33m----- LINKED LIST -----\033[0m\n");

    Node *current = head;

    while (current != NULL) {
        printf("[%s] -> ", current->command);
        current = current->next;
    }

    printf("NULL\n");
}

// Clear the current input line
void clear_input_line(int length) {
    printf("\r\033[2K");

    printf("\033[1;32mmini-shell> \033[0m");

    (void)length;
}

// Read user input with arrow-key history navigation
char *read_input() {
    size_t capacity = INITIAL_CAPACITY;
    size_t length = 0;

    char *buffer = malloc(capacity);

    if (buffer == NULL) {
        perror("Input buffer allocation failed");
        exit(EXIT_FAILURE);
    }

    buffer[0] = '\0';

    int history_position = history_count;

    printf("\033[1;32mmini-shell> \033[0m");
    fflush(stdout);

    while (1) {
        char c;

        if (read(STDIN_FILENO, &c, 1) != 1) {
            free(buffer);
            return NULL;
        }

        // Enter key
        if (c == '\n' || c == '\r') {
            printf("\n");
            break;
        }

        // Backspace
        if (c == 127 || c == 8) {
            if (length > 0) {
                length--;
                buffer[length] = '\0';

                printf("\b \b");
                fflush(stdout);
            }

            continue;
        }

        // Escape sequence handling
        if (c == 27) {
            char seq[2];

            if (read(STDIN_FILENO, &seq[0], 1) != 1)
                continue;

            if (read(STDIN_FILENO, &seq[1], 1) != 1)
                continue;

            if (seq[0] == '[') {

                // Up Arrow: Previous command
                if (seq[1] == 'A') {
                    if (history_position > 0) {
                        history_position--;

                        strcpy(buffer, history[history_position]);
                        length = strlen(buffer);

                        clear_input_line((int)length);
                        printf("%s", buffer);
                        fflush(stdout);
                    }
                }

                // Down Arrow: Next command
                else if (seq[1] == 'B') {
                    if (history_position < history_count - 1) {
                        history_position++;

                        strcpy(buffer, history[history_position]);
                        length = strlen(buffer);
                    } else {
                        history_position = history_count;
                        buffer[0] = '\0';
                        length = 0;
                    }

                    clear_input_line((int)length);
                    printf("%s", buffer);
                    fflush(stdout);
                }
            }

            continue;
        }

        // Accept printable characters
        if (isprint((unsigned char)c)) {

            // Prevent buffer overflow by resizing
            if (length + 1 >= capacity) {
                capacity *= 2;

                char *temp = realloc(buffer, capacity);

                if (temp == NULL) {
                    free(buffer);
                    perror("Input buffer resize failed");
                    exit(EXIT_FAILURE);
                }

                buffer = temp;
            }

            buffer[length++] = c;
            buffer[length] = '\0';

            putchar(c);
            fflush(stdout);
        }
    }

    return buffer;
}

// Release all dynamically allocated memory
void cleanup() {

    // Free history strings
    for (int i = 0; i < history_count; i++) {
        free(history[i]);
    }

    // Free history array
    free(history);

    // Free linked list
    Node *current = head;

    while (current != NULL) {
        Node *temp = current;

        current = current->next;

        free(temp->command);
        free(temp);
    }

    printf("\n\033[1;35mMemory released successfully.\033[0m\n");
}

// Main function
int main() {

    initialize_history();

    printf("\033[1;34m");
    printf("====================================\n");
    printf(" COMMAND HISTORY AND MEMORY MANAGER\n");
    printf("====================================\n");
    printf("\033[0m");

    printf("Type commands to store them in history.\n");
    printf("Use UP/DOWN arrows to navigate history.\n");
    printf("Type 'history' to display command history.\n");
    printf("Type 'list' to display the linked list.\n");
    printf("Type 'exit' to terminate the program.\n\n");

    enable_raw_mode();

    while (1) {

        char *input = read_input();

        if (input == NULL)
            break;

        if (strlen(input) == 0) {
            free(input);
            continue;
        }

        if (strcmp(input, "exit") == 0) {
            free(input);
            break;
        }

        if (strcmp(input, "history") == 0) {
            display_history();
            free(input);
            continue;
        }

        if (strcmp(input, "list") == 0) {
            display_linked_list();
            free(input);
            continue;
        }

        add_to_history(input);

        printf("\033[1;34mStored command: \033[0m%s\n", input);

        free(input);
    }

    restore_terminal();

    cleanup();

    return 0;
}
